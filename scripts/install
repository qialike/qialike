#!/usr/bin/env bash
# Install qialike into ~/.dsh/bin: copy the single-file binary there and make
# sure ~/.dsh/bin is on PATH so `qialike` runs from any directory.
#
# Usage: bash scripts/install   (from the repo root, or from the workspace root
#                                where the repo lives at ./qialike)
set -euo pipefail

NAME="qialike"
# The product's pre-rename command name. Only compatibility/cleanup code may
# name it: the installed copy under it is removed below, and a stale PATH entry
# pointing at its checkout is reported (both would otherwise shadow or replace
# this build silently).
LEGACY_NAME="dsh-tui"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALL_DIR="${HOME}/.dsh/bin"
DEST="$INSTALL_DIR/$NAME"

# Locate the binary. Candidates cover running from the repo root (./dist) and
# from the workspace root (./qialike/dist), both the single-target build
# (dist/qialike) and the platform dirs (dist/linux-x64/qialike, ...).
find_binary() {
  local base
  for base in "$REPO_ROOT" "$(pwd)"; do
    local cand
    for cand in \
      "$base/dist/$NAME" \
      "$base/dist/linux-x64/$NAME" \
      "$base/$NAME/dist/$NAME" \
      "$base/$NAME/dist/linux-x64/$NAME"; do
      if [[ -x "$cand" ]]; then
        printf '%s\n' "$cand"
        return 0
      fi
    done
    local dir
    for dir in "$base"/dist/*/; do
      [[ -d "$dir" && -x "$dir/$NAME" ]] || continue
      printf '%s\n' "$dir/$NAME"
      return 0
    done
  done
  return 1
}

BIN="$(find_binary)" || {
  echo "qialike: binary not found under $REPO_ROOT/dist (or ./qialike/dist); run \`pnpm build --single\` first" >&2
  exit 1
}

mkdir -p "$INSTALL_DIR"
cp "$BIN" "$DEST"
chmod +x "$DEST"
echo "qialike: installed  $DEST"

# A copy installed under the pre-rename name would otherwise keep shadowing this
# one on PATH (`dsh-tui` still resolves, and runs the old build). Remove it and
# say so — including the rename itself, because the user's muscle memory (and
# any script of theirs) still says `dsh-tui` — instead of leaving two commands
# for one program.
LEGACY_DEST="$INSTALL_DIR/$LEGACY_NAME"
if [[ -e "$LEGACY_DEST" ]]; then
  rm -f "$LEGACY_DEST"
  echo "qialike: removed the pre-rename binary $LEGACY_DEST ($LEGACY_NAME is now $NAME)"
fi

# Every UNCOMMENTED PATH export in one shell profile, as `lineno:line`. The
# `-n` is kept so a warning can name the exact line the user has to edit, and
# the `^[[:space:]]*export` anchor is what keeps `# export PATH=…` out.
live_path_lines() {
  grep -nE '^[[:space:]]*export[[:space:]]+PATH=' "$1" 2>/dev/null || true
}

# PATH entries naming the pre-rename product point at a checkout directory the
# rename removed, so they can never resolve. Report them (never edit them: they
# are the user's own lines) — this is the state that reads as "the rename broke
# my command", with no hint anywhere telling the user which line to fix.
for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
  [[ -f "$rc" ]] || continue
  stale=()
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    line="${entry#*:}"
    if [[ "$line" == *"$LEGACY_NAME"* ]]; then
      stale+=("${rc}:${entry}")
    fi
  done < <(live_path_lines "$rc")
  if (( ${#stale[@]} > 0 )); then
    echo "qialike: warning — $rc still exports a pre-rename PATH entry, which cannot resolve:"
    for entry in "${stale[@]}"; do
      echo "            $entry"
    done
    echo "          \`$LEGACY_NAME\` was renamed to \`$NAME\`, so that directory is gone."
    echo "          Delete or update that line (the current checkout is $REPO_ROOT/dist)."
  fi
done

# Make sure ~/.dsh/bin is on PATH for future shells (and tell the user how to
# enable it in the current one).
#
# "Configured" means an UNCOMMENTED export names ~/.dsh/bin. A plain
# `grep -F "$PATH_LINE"` also matched a commented-out copy of the very same text
# — the state a profile ends up in when the line was disabled by hand — so the
# installer called the line configured, appended nothing, and closed by telling
# the user to `source ~/.bashrc`: `qialike: command not found` survived the
# install that claimed to fix it.
PATH_LINE='export PATH="$HOME/.dsh/bin:$PATH"'
if [[ ":$PATH:" == *":$INSTALL_DIR:"* ]]; then
  echo "qialike: $INSTALL_DIR is already on PATH"
else
  # Profiles this run actually wrote, so the closing hint names a file that
  # exists (a fresh HOME has neither `.bashrc` nor `.zshrc` — telling the user
  # to `source ~/.bashrc` there is advice they cannot follow).
  appended_rcs=()
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [[ -f "$rc" ]] || continue
    configured=0
    while IFS= read -r entry; do
      [[ -n "$entry" ]] || continue
      if [[ "${entry#*:}" == *".dsh/bin"* ]]; then
        configured=1
      fi
    done < <(live_path_lines "$rc")
    if (( configured )); then
      echo "qialike: $rc already exports $INSTALL_DIR on PATH"
      continue
    fi
    printf '\n# qialike\n%s\n' "$PATH_LINE" >> "$rc"
    appended_rcs+=("$rc")
    echo "qialike: appended to $rc: $PATH_LINE"
    if grep -qsE '^[[:space:]]*#[[:space:]]*export[[:space:]]+PATH=.*\.dsh/bin' "$rc"; then
      echo "qialike: note — $rc also holds a commented-out copy of that line; the live one just added is the one in effect"
    fi
  done
  echo "qialike: $INSTALL_DIR is not on PATH in this shell; run the following now,"
  echo "          or open a new terminal:"
  # Guarded: on bash 3.2 (macOS `/bin/bash`) `"${arr[@]}"` on an EMPTY array
  # trips `set -u` as an unbound variable, which would abort the install at its
  # last line.
  if (( ${#appended_rcs[@]} > 0 )); then
    for rc in "${appended_rcs[@]}"; do
      echo "            source $rc"
    done
  fi
  echo "            $PATH_LINE"
fi

echo "qialike: installed. Run 'qialike' (or 'qialike uninstall')."
