{
  "name": "@yourname/dsh-tui-app",
  "description": "The dsh TUI bundle: a full-screen Ink/React terminal surface over dsh-base, with a single interactive agent session.",
  "version": "0.2.3-beta",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourname/dsh-tui.git",
    "directory": "packages/dsh-tui-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./models": {
      "types": "./lib/types/models.d.ts",
      "default": "./lib/models.js"
    },
    "./opencode": {
      "types": "./lib/types/opencode.d.ts",
      "default": "./lib/opencode.js"
    },
    "./china-gateways": {
      "types": "./lib/types/china-gateways.d.ts",
      "default": "./lib/china-gateways.js"
    },
    "./foreign-gateways": {
      "types": "./lib/types/foreign-gateways.d.ts",
      "default": "./lib/foreign-gateways.js"
    },
    "./azure": {
      "types": "./lib/types/azure.d.ts",
      "default": "./lib/azure.js"
    },
    "./theme-plugin": {
      "types": "./lib/types/theme-plugin.d.ts",
      "default": "./lib/theme-plugin.js"
    },
    "./sessions": {
      "types": "./lib/types/sessions.d.ts",
      "default": "./lib/sessions.js"
    },
    "./export": {
      "types": "./lib/types/export.d.ts",
      "default": "./lib/export.js"
    },
    "./new": {
      "types": "./lib/types/new.d.ts",
      "default": "./lib/new.js"
    },
    "./goal": {
      "types": "./lib/types/goal.d.ts",
      "default": "./lib/goal.js"
    },
    "./plan": {
      "types": "./lib/types/plan.d.ts",
      "default": "./lib/plan.js"
    },
    "./selftest": {
      "types": "./lib/types/selftest.d.ts",
      "default": "./lib/selftest.js"
    },
    "./panels-conversation": {
      "types": "./lib/types/panels/conversation.d.ts",
      "default": "./lib/panels/conversation.js"
    },
    "./panels-approval": {
      "types": "./lib/types/panels/approval.d.ts",
      "default": "./lib/panels/approval.js"
    },
    "./panels-question": {
      "types": "./lib/types/panels/question.d.ts",
      "default": "./lib/panels/question.js"
    },
    "./panels-models": {
      "types": "./lib/types/panels/models.d.ts",
      "default": "./lib/panels/models.js"
    },
    "./llm": {
      "types": "./lib/types/llm.d.ts",
      "default": "./lib/llm.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^4.4.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^18.3.1",
    "string-width": "^5.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.1",
    "@deepseek-ai/cordis-plugin-loader": "^0.1.1",
    "@deepseek-ai/dsh-agent": "^0.1.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.1",
    "@deepseek-ai/dsh-compaction": "^0.1.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1",
    "@deepseek-ai/dsh-goal": "^0.1.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1",
    "@deepseek-ai/dsh-llm": "^0.1.1",
    "@deepseek-ai/dsh-plan-mode": "^0.1.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.1",
    "@deepseek-ai/dsh-session": "^0.1.1",
    "@deepseek-ai/dsh-session-title": "^0.1.1",
    "@deepseek-ai/dsh-tools": "^0.1.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.1",
    "@deepseek-ai/dsh-user-questions": "^0.1.1",
    "@deepseek-ai/schemastery": "^0.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0"
  }
}
